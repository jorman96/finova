rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function member(empresaId) {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.activo == true &&
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.empresaId == empresaId &&
        firestore.get(/databases/(default)/documents/empresas/$(empresaId)).data.estado == 'activa';
    }
    match /empresas/{empresaId}/{allPaths=**} {
      allow read: if member(empresaId);
      allow create: if member(empresaId) &&
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol in ['superadmin','dueño','admin','cajero','cobrador'] &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)|application/pdf');
      allow update, delete: if false;
    }
  }
}
